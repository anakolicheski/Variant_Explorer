column(3, selectInput(ns("alt_col"), "ALT column:", choices = NULL))
),
actionButton(ns("create_id"), "Create Variant IDs", class = "btn-primary")
)
),
# Step 3: ID Preview & Confirmation
conditionalPanel(
condition = sprintf("output['%s']", ns("id_created")),
wellPanel(
h4("Step 3: Review Generated IDs"),
p("Preview of generated variant IDs (CHR_POS_REF_ALT):"),
tableOutput(ns("id_preview")),
actionButton(ns("confirm_id"), "Confirm IDs", class = "btn-success"),
actionButton(ns("reset_id"), "Reset & Edit Columns", class = "btn-warning")
)
),
# Step 4: Column Selection
conditionalPanel(
condition = sprintf("output['%s']", ns("id_confirmed")),
wellPanel(
h4("Step 4: Select Additional Columns"),
fluidRow(
column(6,
checkboxGroupInput(
ns("anno_cols"),
"Annotation Columns:",
choices = NULL
)
),
column(6,
checkboxGroupInput(
ns("geno_cols"),
"Genotype Columns:",
choices = NULL
)
)
),
actionButton(ns("process_data"), "Process & Save Files", class = "btn-success")
)
),
# Step 5: Processing Summary
conditionalPanel(
condition = sprintf("output['%s']", ns("processing_complete")),
wellPanel(
h4("Processing Complete!"),
verbatimTextOutput(ns("processing_summary")),
actionButton(ns("reset_all"), "Upload Another Sample", class = "btn-info")
)
),
hr(),
h4("Preview"),
verbatimTextOutput(ns("status_message")),
tableOutput(ns("data_preview"))
)
}
############################################
## Shiny module server
############################################
variantUploadServer <- function(id, annotation_dir = "annotations", genotype_dir = "New_genotypes") {
moduleServer(id, function(input, output, session) {
# Create directories if they don't exist
if (!dir.exists(annotation_dir)) dir.create(annotation_dir, recursive = TRUE)
if (!dir.exists(genotype_dir)) dir.create(genotype_dir, recursive = TRUE)
# Reactive values to track state
state <- reactiveValues(
file_loaded = FALSE,
id_created = FALSE,
id_confirmed = FALSE,
processing_complete = FALSE,
raw_data = NULL,
data_with_id = NULL,
processed_anno = NULL,
processed_geno = NULL
)
# Output flags for conditional panels
output$file_loaded <- reactive({ state$file_loaded })
output$id_created <- reactive({ state$id_created })
output$id_confirmed <- reactive({ state$id_confirmed })
output$processing_complete <- reactive({ state$processing_complete })
outputOptions(output, "file_loaded", suspendWhenHidden = FALSE)
outputOptions(output, "id_created", suspendWhenHidden = FALSE)
outputOptions(output, "id_confirmed", suspendWhenHidden = FALSE)
outputOptions(output, "processing_complete", suspendWhenHidden = FALSE)
# Load raw data
observeEvent(input$variant_file, {
req(input$variant_file)
tryCatch({
# Detect delimiter
first_line <- readLines(input$variant_file$datapath, n = 1)
delim <- if (str_detect(first_line, "\t")) "\t" else ","
df <- readr::read_delim(
input$variant_file$datapath,
delim = delim,
quote = "\"",
col_names = TRUE,
trim_ws = TRUE,
show_col_types = FALSE
)
# Clean column names
names(df) <- names(df) %>%
str_trim() %>%
str_replace_all('"', '')
# Drop unnamed columns
unnamed <- names(df) == "" | grepl("^\\.\\.\\.", names(df))
df <- df[, !unnamed, drop = FALSE]
state$raw_data <- df
state$file_loaded <- TRUE
output$status_message <- renderText({
sprintf("File loaded: %d rows, %d columns", nrow(df), ncol(df))
})
}, error = function(e) {
output$status_message <- renderText({
paste("Error loading file:", e$message)
})
})
})
# Update column dropdowns when file is loaded
observe({
req(state$raw_data)
df <- state$raw_data
cols <- names(df)
# Auto-detect columns
chr_col <- find_col(df, required_cols$chr)
pos_col <- find_col(df, required_cols$pos)
ref_col <- find_col(df, required_cols$ref)
alt_col <- find_col(df, required_cols$alt)
# Update dropdowns
updateSelectInput(session, "chr_col", choices = cols, selected = chr_col)
updateSelectInput(session, "pos_col", choices = cols, selected = pos_col)
updateSelectInput(session, "ref_col", choices = cols, selected = ref_col)
updateSelectInput(session, "alt_col", choices = cols, selected = alt_col)
})
# Create IDs
observeEvent(input$create_id, {
req(state$raw_data)
req(input$chr_col, input$pos_col, input$ref_col, input$alt_col)
# Validate unique columns
if (length(unique(c(input$chr_col, input$pos_col, input$ref_col, input$alt_col))) != 4) {
output$status_message <- renderText({
"Error: All four core columns must be different!"
})
return()
}
df <- state$raw_data
# Create ID
df$ID <- paste(
df[[input$chr_col]],
df[[input$pos_col]],
df[[input$ref_col]],
df[[input$alt_col]],
sep = "_"
)
state$data_with_id <- df
state$id_created <- TRUE
output$status_message <- renderText({
sprintf("Created %d variant IDs", nrow(df))
})
})
# Preview IDs
output$id_preview <- renderTable({
req(state$data_with_id)
df <- state$data_with_id
preview <- df %>%
select(
CHR = !!input$chr_col,
POS = !!input$pos_col,
REF = !!input$ref_col,
ALT = !!input$alt_col,
ID
) %>%
head(10)
preview
})
# Confirm IDs
observeEvent(input$confirm_id, {
state$id_confirmed <- TRUE
# Update column selection for anno/geno
df <- state$data_with_id
core_cols <- c(input$chr_col, input$pos_col, input$ref_col, input$alt_col, "ID")
remaining_cols <- setdiff(names(df), core_cols)
# Default: all remaining go to annotation
updateCheckboxGroupInput(
session,
"anno_cols",
choices = remaining_cols,
selected = remaining_cols
)
updateCheckboxGroupInput(
session,
"geno_cols",
choices = remaining_cols,
selected = character(0)
)
})
# Reset ID creation
observeEvent(input$reset_id, {
state$id_created <- FALSE
state$id_confirmed <- FALSE
state$data_with_id <- NULL
})
# Process and save data
observeEvent(input$process_data, {
req(state$data_with_id)
req(input$sample_name != "")
df <- state$data_with_id
tryCatch({
# Build annotation table
anno <- df %>%
transmute(
CHR = !!sym(input$chr_col),
POS = !!sym(input$pos_col),
REF = !!sym(input$ref_col),
ALT = !!sym(input$alt_col),
ID = ID
)
# Add selected annotation columns
if (length(input$anno_cols) > 0) {
anno <- bind_cols(anno, df %>% select(all_of(input$anno_cols)))
}
# Clean numeric columns
numeric_cols <- c("POS", "PHRED", "gnomADw_AF", "gnomADe_AF", "gnomADe_Hom",
"db_pop_freq_max_AF", "cDNApos", "CDSpos", "protPos")
anno <- ensure_numeric(anno, numeric_cols)
# Clean consequence columns
consequence_cols <- c("Consequence_VEP", "Consequence_CADD")
for (col in consequence_cols) {
if (col %in% names(anno)) {
anno[[col]] <- clean_consequence_column(anno[[col]])
}
}
# Remove duplicates by severity
original_rows <- nrow(anno)
anno <- remove_duplicates_by_severity(anno, consequence_col = "Consequence_VEP")
duplicates_removed <- original_rows - nrow(anno)
# Build genotype table
geno <- NULL
if (length(input$geno_cols) > 0) {
geno <- df %>%
select(ID, all_of(input$geno_cols))
# Remove duplicates from genotype too
geno <- geno[!duplicated(geno$ID), ]
}
# Save files
anno_file <- file.path(annotation_dir, "annotations_fordb.tsv")
geno_file <- file.path(genotype_dir, paste0(input$sample_name, "_geno.tsv"))
# Handle annotation file (append or create)
if (file.exists(anno_file)) {
# Load existing annotations
existing_anno <- read_tsv(anno_file, show_col_types = FALSE)
# Merge columns (keep all columns from both)
all_cols <- union(names(existing_anno), names(anno))
# Add missing columns with NA
for (col in setdiff(all_cols, names(existing_anno))) {
existing_anno[[col]] <- NA
}
for (col in setdiff(all_cols, names(anno))) {
anno[[col]] <- NA
}
# Combine
combined_anno <- bind_rows(existing_anno, anno)
# Remove duplicates again (prioritize most severe)
combined_anno <- remove_duplicates_by_severity(combined_anno)
write_tsv(combined_anno, anno_file)
anno_status <- sprintf("Appended to existing: %d new variants added",
nrow(combined_anno) - nrow(existing_anno))
} else {
write_tsv(anno, anno_file)
anno_status <- sprintf("Created new file: %d variants", nrow(anno))
}
# Save genotype file
geno_status <- "No genotype columns selected"
if (!is.null(geno)) {
write_tsv(geno, geno_file)
geno_status <- sprintf("Saved: %d variants", nrow(geno))
}
# Update state
state$processed_anno <- anno
state$processed_geno <- geno
state$processing_complete <- TRUE
output$processing_summary <- renderText({
paste(
sprintf("Sample: %s\n", input$sample_name),
sprintf("Original rows: %d\n", original_rows),
sprintf("Duplicates removed: %d\n", duplicates_removed),
sprintf("\nAnnotation file: %s\n", anno_status),
sprintf("Genotype file: %s\n", geno_status),
sprintf("\nFiles saved to:\n- %s\n- %s", anno_file, geno_file),
sep = ""
)
})
}, error = function(e) {
output$status_message <- renderText({
paste("Error processing data:", e$message)
})
})
})
# Reset all
observeEvent(input$reset_all, {
state$file_loaded <- FALSE
state$id_created <- FALSE
state$id_confirmed <- FALSE
state$processing_complete <- FALSE
state$raw_data <- NULL
state$data_with_id <- NULL
updateTextInput(session, "sample_name", value = "")
})
# Data preview
output$data_preview <- renderTable({
if (state$processing_complete && !is.null(state$processed_anno)) {
head(state$processed_anno, 5)
} else if (state$id_confirmed && !is.null(state$data_with_id)) {
head(state$data_with_id, 5)
} else if (state$file_loaded && !is.null(state$raw_data)) {
head(state$raw_data, 5)
}
})
# Return processed data for use in main app
return(reactive({
list(
anno = state$processed_anno,
geno = state$processed_geno,
sample_name = input$sample_name
)
}))
})
}
# lolliplot_module.R
library(shiny)
library(biomaRt)
library(trackViewer)
library(GenomicRanges)
library(stringr)
library(DT)
library(dplyr)
# UI
lolliplotUI <- function(id) {
ns <- NS(id)
tagList(
selectizeInput(
ns("selected_gene"),
"Select a Gene",
choices = NULL,
selected = NULL,
multiple = FALSE,
options = list(
placeholder = "Select a gene from uploaded list",
maxOptions = 500
)
),
plotOutput(ns("lollipopPlot"), hover = ns("plot_hover")),
br(),
h4("Variant & Domain Summary"),
DT::dataTableOutput(ns("summaryTable"))
)
}
# Server
lolliplotServer <- function(id, variant_data_reactive, pheno, list_of_files) {
moduleServer(id, function(input, output, session) {
ns <- session$ns
# Define consequence color mapping globally inside module
consequence_colors <- c(
missense_variant = "steelblue",
nonsense_variant = "red",
splice_region_variant = "orange",
frameshift_variant = "purple",
synonymous_variant = "grey"
)
# Update gene choices based on variant data
observeEvent(variant_data_reactive(), {
genes <- sort(unique(variant_data_reactive()$GeneName))
updateSelectizeInput(session, "selected_gene", choices = genes, server = TRUE)
})
# Fetch protein domains via biomaRt
get_protein_domains <- function(gene_symbol) {
ensembl <- useMart("ensembl", dataset = "hsapiens_gene_ensembl")
domain_info <- tryCatch({
getBM(
attributes = c("external_gene_name", "uniprotswissprot", "pfam",
"pfam_start", "pfam_end", "description"),
filters = "hgnc_symbol",
values = gene_symbol,
mart = ensembl
)
}, error = function(e) {
warning("biomaRt query failed: ", conditionMessage(e))
return(NULL)
})
if (is.null(domain_info) || nrow(domain_info) == 0) return(NULL)
domain_info <- domain_info[!is.na(domain_info$pfam_start) & !is.na(domain_info$pfam_end), ]
if (nrow(domain_info) == 0) return(NULL)
domain_colors <- rep_len(c("#FF8833", "#51C6E6", "#DFA32D", "#AAAAAA"), nrow(domain_info))
domain_gr <- GRanges(
seqnames = Rle(paste0("chr", gene_symbol), nrow(domain_info)),
ranges = IRanges(start = domain_info$pfam_start, end = domain_info$pfam_end),
names = domain_info$pfam
)
mcols(domain_gr)$feature <- domain_info$description
mcols(domain_gr)$fill <- domain_colors
mcols(domain_gr)$height <- 0.08
domain_gr
}
# Reactive filtered variants for selected gene
variants_for_gene <- reactive({
req(input$selected_gene)
df <- variant_data_reactive()
df <- df[df$GeneName == input$selected_gene, ]
df$AA_pos <- suppressWarnings(as.numeric(str_extract(df$protein_change, "\\d+")))
df <- df[!is.na(df$AA_pos), ]
# Initialize a tibble to store patient info
patient_info <- tibble()
for (patient_file in list_of_files) {
geno <- get(patient_file) %>% mutate_all(as.character)
matches <- geno %>% filter(ID %in% df$ID) %>%
mutate(Patient = patient_file)
patient_info <- bind_rows(patient_info, matches)
}
# Merge with phenotype table
if (exists("pheno") && nrow(patient_info) > 0) {
patient_info <- left_join(patient_info, pheno %>% dplyr::select(Patient, Term_1),
by = "Patient", relationship = "many-to-many")
}
# Add Patient and Term_1 info to variants df
if (nrow(patient_info) > 0) {
info_summary <- patient_info %>%
group_by(ID) %>%
summarize(
Patients = paste(unique(Patient), collapse = ", "),
Phenotypes = paste(unique(Term_1), collapse = ", "),
.groups = "drop"
)
df <- left_join(df, info_summary, by = "ID")
} else {
df$Patients <- NA
df$Phenotypes <- NA
}
df
})
# Lollipop plot
output$lollipopPlot <- renderPlot({
df <- variants_for_gene()
gene <- input$selected_gene
if (nrow(df) == 0) {
plot.new(); title("No variants found for selected gene."); return()
}
domain_gr <- get_protein_domains(gene)
if (is.null(domain_gr)) {
plot.new(); title("No domain data available from Ensembl."); return()
}
# Build GRanges object for variants
variant_gr <- GRanges(
seqnames = paste0("chr", gene),
ranges = IRanges(start = df$AA_pos, width = 1),
names = paste0("var", seq_along(df$AA_pos))
)
mcols(variant_gr)$score <- 1
mcols(variant_gr)$color <- consequence_colors[as.character(df$Consequence_VEP)]
mcols(variant_gr)$color[is.na(mcols(variant_gr)$color)] <- "black"
# hover info: Patient + Term_1
mcols(variant_gr)$label <- paste0(
df$Consequence_VEP,
"\nPatients: ", ifelse(is.na(df$Patients), "NA", df$Patients),
"\nPhenotypes: ", ifelse(is.na(df$Phenotypes), "NA", df$Phenotypes)
)
lolliplot(variant_gr, domain_gr)
})
# Summary table
output$summaryTable <- DT::renderDataTable({
df <- variants_for_gene()
gene <- input$selected_gene
req(nrow(df) > 0)
# Variant summary
variant_tbl <- data.frame(
Type = "Variant",
Position = as.character(df$AA_pos),
Description = df$Consequence_VEP,
Patients = ifelse(is.na(df$Patients), "", df$Patients),
Phenotypes = ifelse(is.na(df$Phenotypes), "", df$Phenotypes),
Color = consequence_colors[as.character(df$Consequence_VEP)]
)
variant_tbl$Color[is.na(variant_tbl$Color)] <- "black"
# Domain summary
domain_gr <- get_protein_domains(gene)
if (!is.null(domain_gr)) {
domain_tbl <- data.frame(
Type = "Domain",
Position = paste0(start(domain_gr), "-", end(domain_gr)),
Description = mcols(domain_gr)$feature,
Color = mcols(domain_gr)$fill
)
combined_tbl <- bind_rows(variant_tbl, domain_tbl)
} else {
combined_tbl <- variant_tbl
}
DT::datatable(combined_tbl, rownames = FALSE, options = list(pageLength = 5))
})
})
}
library(stringr)
